# pnpm config for the prevblock workspace.
#
# public-hoist-pattern: lifts the named packages out of pnpm's
# isolated node_modules layout into the top-level node_modules/.
# Required for two reasons:
#
# 1. Vercel's framework detector calls require('next/package.json')
#    from the project root and fails if next isn't at
#    node_modules/next. pnpm 9's default isolated layout puts it at
#    node_modules/.pnpm/next@x.y.z/node_modules/next, which Vercel
#    can't find. Public-hoisting next + react makes them visible to
#    require() from the workspace root without breaking pnpm's
#    isolation guarantees for the rest of the tree.
#
# 2. Some tools (next, tailwind, postcss) walk the parent directory
#    chain looking for plugins. Public-hoisting their common helpers
#    keeps them resolvable from any workspace package.
public-hoist-pattern[]=next
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*tailwind*
public-hoist-pattern[]=*postcss*

# Don't fail on peer dep mismatches during install. pnpm 9 is
# strict about this; we still want to ship.
strict-peer-dependencies=false
