# ---- Tidecoin node RPC (matches docs/rpc-surface.md) ----
TIDECOIN_RPC_URL=http://127.0.0.1:8332/
TIDECOIN_RPC_USER=satoshi
TIDECOIN_RPC_PASSWORD=satoshi
TIDECOIN_RPC_TIMEOUT_MS=30000

# ---- backend ----
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# ---- postgres (Phase 2) ----
DATABASE_URL=postgres://prevblock:prevblock@127.0.0.1:5432/prevblock

# ---- redis (Phase 1.6) ----
REDIS_URL=redis://127.0.0.1:6379/0
