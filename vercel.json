{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @prevblock/shared build && pnpm -C packages/frontend build",
  "installCommand": "npm install -g pnpm@9.12.0 && pnpm --version && pnpm install --no-frozen-lockfile",
  "outputDirectory": "packages/frontend/.next",
  "framework": "nextjs"
}
