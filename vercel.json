{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @prevblock/shared build && pnpm -C packages/frontend build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "packages/frontend/.next",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./packages/frontend ./packages/shared"
}
